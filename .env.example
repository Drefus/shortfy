# memory | postgres
STORAGE=memory
PORT=3000
# Necessário apenas quando STORAGE=postgres (ex.: string de conexão do Neon).
# Hosts remotos usam SSL com verificação de certificado; localhost, sem SSL.
DATABASE_URL=
# Endereço público usado para montar os links curtos.
# No Render, se ficar vazio, é usado RENDER_EXTERNAL_URL.
BASE_URL=http://localhost:3000
# Máximo de links criados por minuto por IP
RATE_LIMIT_PER_MINUTE=30
# Número de proxies reversos à frente do app (1 no Render; 0 desliga)
TRUST_PROXY=1
